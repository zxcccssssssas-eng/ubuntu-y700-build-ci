# Ubuntu-like extra kernel features for TB321FU / SM8650.
# Applied on top of the existing device kernel.config.
# Keep kABI: do not change LOCALVERSION, page size, VA bits, preempt model,
# or existing built-in (=y) options. New features are modules unless they
# must be built-in (BTF debug info, TCP congestion menu, IP advanced
# router / IPv4 policy routing).

# IP advanced router is bool (not a module). Without it, IPv4 policy
# routing and extra tables are compiled out, so userspace TUN (OpenVPN,
# clash/sing-box, wireguard-go, etc.) cannot install `ip rule` / table
# routes even though CONFIG_TUN is already built-in.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_FIB_TRIE_STATS=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_ROUTE_VERBOSE=y
CONFIG_IP_ROUTE_CLASSID=y
CONFIG_FIB_RULES=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_MROUTE=y
CONFIG_IP_MROUTE_MULTIPLE_TABLES=y

# WireGuard / TUN extras (TUN is already built-in)
CONFIG_WIREGUARD=m
# CONFIG_WIREGUARD_DEBUG is not set
CONFIG_DUMMY=m
CONFIG_BONDING=m
CONFIG_IPVLAN=m
CONFIG_IPVTAP=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_BAREUDP=m
CONFIG_GTP=m
CONFIG_MACSEC=m
CONFIG_NET_TEAM=m
CONFIG_NET_TEAM_MODE_ROUNDROBIN=m
CONFIG_NET_TEAM_MODE_ACTIVEBACKUP=m
CONFIG_NET_TEAM_MODE_LOADBALANCE=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_TAP=m
CONFIG_NLMON=m
CONFIG_NETKIT=m
CONFIG_PPP=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_FILTER=y
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m
CONFIG_PPPOL2TP=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m

# BBR and fair-queueing (BBR wants fq)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=m
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=m
CONFIG_TCP_CONG_HTCP=m
