CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y

# KVM extras (KVM itself is already built-in)
CONFIG_KVM_ARM_PMU=y
CONFIG_VFIO_NOIOMMU=y
CONFIG_VHOST_CROSS_ENDIAN_LEGACY=y
